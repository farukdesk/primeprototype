<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded gradient banner behind the student header on the Results screen. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="@color/header_gradient_start"
        android:centerColor="@color/header_gradient_center"
        android:endColor="@color/header_gradient_end"
        android:type="linear" />
    <corners android:radius="18dp"/>
</shape>
